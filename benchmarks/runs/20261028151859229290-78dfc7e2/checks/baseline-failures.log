record = {'module': 'akas.ops.linear.webgpu', 'computations': ['inline:0dbef03cac768cdbdbe0a6793ca2a717aea4cf81a21a7fb5d71e74c6...16823fd9585d0665f42bb3306dc21704b34d947848a9c7d3c', ...], 'related_modules': ['akas.quantization.weights.ggml.webgpu']}

    @pytest.mark.parametrize("record", MODULES, ids=lambda row: row["module"])
    def test_kernel_arithmetic_matches_pre_refactor_source(record):
        from akas.benchmarking.archive import read_file
    
        observed = set()
        for module in (record["module"], *record.get("related_modules", ())):
            path = ROOT / "src" / Path(module.replace(".", "/")).with_suffix(".py")
            observed.update(computation_hashes(path.read_text()))
        # Refactoring preserves frozen computations. An intentional optimization
        # explicitly identifies both bodies and its retained numerical qualification.
        required = set(record["computations"])
        for replacement in record.get("qualified_replacements", ()):
            original, updated = (
                set(replacement["original"]),
                set(replacement["replacement"]),
            )
            assert original and original <= required
            assert updated
            assert replacement["reason"] and replacement["qualification_tests"]
            identity = replacement["qualification_run"]
            run = json.loads(read_file(ROOT / "benchmarks", "runs", identity, "run.json"))
            report = json.loads(
                read_file(ROOT / "benchmarks", "runs", identity, "report.json")
            )
            assert run["status"] == "passed"
            checks = report["metadata"]["checks"]
