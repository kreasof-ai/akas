+                dots[i,][0],
+                maxima[i,][0],
+                norms[i,][0],
+                factors[i,][0],
+                probs,
+                positions,
+                enabled,
+                row0,
+                base,
+                head,
+                lane,
+                i,
+            )
+
+    @T.macro
+    def rescale(value: T.Ref, factor):
+        value *= factor
