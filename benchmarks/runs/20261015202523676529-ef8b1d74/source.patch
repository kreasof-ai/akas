+    def get(self, name, emit):
+        if name not in self.valid:
+            source = self.sources[name]
+            parameters = dict(r=self.rows, k=source.shape[-1])
+            if len(source.shape) == 3:
+                parameters["top"] = source.shape[-2]
+            bits, scales = self.quantized[name]
