+class FP8ActivationCache:
+    """FP8 graph scratch reuse; invalidate borrowed storage on source writes."""
+
+    def __init__(self, sources, quantized, *, rows):
+        self.sources = sources
+        self.quantized = quantized
+        self.rows = rows
