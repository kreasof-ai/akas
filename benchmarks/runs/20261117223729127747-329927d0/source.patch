diff --git a/src/akas/ops/vocabulary/kernel.py b/src/akas/ops/vocabulary/kernel.py
index e0c24b0f..94e78280 100644
--- a/src/akas/ops/vocabulary/kernel.py
+++ b/src/akas/ops/vocabulary/kernel.py
@@ -421,3 +421,255 @@ def codebook_residual(spec, schedule):
         return out
 
