        {
          "id": "ml-0942",
          "lang": "ml",
          "tier": "medium",
          "source_row": 942,
          "text": "\u0d2e\u0d4b\u0d7d\u0d26\u0d4b\u0d35\u0d2f\u0d3f\u0d32\u0d46 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d2e\u0d24\u0d02 \u0d13\u0d7c\u0d24\u0d4d\u0d24\u0d21\u0d4b\u0d15\u0d4d\u0d38\u0d4d \u0d15\u0d4d\u0d30\u0d3f\u0d38\u0d4d\u0d24\u0d4d\u0d2f\u0d28\u0d3e\u0d23\u0d4d."
        },
        {
          "id": "ml-0030",
          "lang": "ml",
          "tier": "medium",
          "source_row": 30,
          "text": "\u0d08 \u0d15\u0d23\u0d4d\u0d1f\u0d41\u0d2a\u0d3f\u0d1f\u0d3f\u0d24\u0d4d\u0d24\u0d02 \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d33\u0d3f\u0d32\u0d46 \u0d24\u0d42\u0d35\u0d32\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d7d\u0d2d\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d46\u0d33\u0d3f\u0d1a\u0d4d\u0d1a\u0d02 \u0d35\u0d40\u0d36\u0d3f."
        },
        {
          "id": "ml-0082",
          "lang": "ml",
          "tier": "long",
          "source_row": 82,
          "text": "\u0d1c\u0d46\u0d31\u0d3f \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d7d \u0d15\u0d30\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 \u0d2d\u0d40\u0d37\u0d23\u0d3f\u0d2f\u0d41\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d26\u0d47\u0d36\u0d40\u0d2f \u0d1a\u0d41\u0d34\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 (\u0d0e\u0d7b\u200c\u0d0e\u0d1a\u0d4d\u0d1a\u0d4d\u200c\u0d38\u0d3f) \u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41."
        },
        {
          "id": "ml-0977",
          "lang": "ml",
          "tier": "long",
          "source_row": 977,
          "text": "\u0d28\u0d3f\u0d30\u0d40\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f \u0d05\u0d15\u0d4d\u0d37\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d38\u0d3f, \u0d1c\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3e\u0d23\u0d4d, \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d05\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d09\u0d1a\u0d4d\u0d1a\u0d3e\u0d30\u0d23\u0d02 \u0d05\u0d24\u0d4d \u0d15\u0d34\u0d3f\u0d1e\u0d4d\u0d1e\u0d4d \u0d35\u0d30\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d4d\u0d35\u0d30\u0d3e\u0d15\u0d4d\u0d37\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d46 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d3e\u0d23\u0d4d."
        },
        {
          "id": "pa-0007",
          "lang": "pa",
          "tier": "short",
          "source_row": 7,
          "text": "\u0a09\u0a38\u0a28\u0a47 \u0a15\u0a3f\u0a39\u0a3e, \u0a09\u0a38\u0a28\u0a47 \u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a08-\u0a2b\u0a3e\u0a08 \u0a21\u0a4b\u0a30 \u0a2c\u0a48\u0a71\u0a32 \u0a2c\u0a23\u0a3e\u0a08 \u0a39\u0a48\u0964"
        },
        {
          "id": "pa-0320",
          "lang": "pa",
          "tier": "short",
          "source_row": 320,
          "text": "\u0a38\u0a3e\u0a25\u0a40 \u0a2a\u0a39\u0a3f\u0a32\u0a35\u0a3e\u0a28\u0a3e\u0a02 \u0a28\u0a47 \u0a35\u0a40 \u0a32\u0a41\u0a28\u0a3e \u0a28\u0a42\u0a70 \u0a36\u0a30\u0a27\u0a3e\u0a02\u0a1c\u0a32\u0a40 \u0a2d\u0a47\u0a1f \u0a15\u0a40\u0a24\u0a40\u0964"
        },
        {
          "id": "pa-0942",
          "lang": "pa",
          "tier": "medium",
          "source_row": 942,
          "text": "\u0a2e\u0a4b\u0a32\u0a26\u0a4b\u0a35\u0a3e \u0a26\u0a3e \u0a35\u0a71\u0a21\u0a3e \u0a27\u0a30\u0a2e \u0a15\u0a71\u0a1f\u0a5c \u0a08\u0a38\u0a3e\u0a08 \u0a27\u0a30\u0a2e \u0a39\u0a48\u0964"
        },
        {
          "id": "pa-0030",
          "lang": "pa",
          "tier": "medium",
          "source_row": 30,
          "text": "\u0a07\u0a39 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a2a\u0a70\u0a1b\u0a40\u0a06\u0a02 \u0a26\u0a47 \u0a16\u0a70\u0a2d\u0a3e\u0a02 \u0a2c\u0a3e\u0a30\u0a47 \u0a35\u0a40 \u0a38\u0a42\u0a1d \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a40 \u0a39\u0a48\u0964"
        },
        {
          "id": "pa-0082",
          "lang": "pa",
          "tier": "long",
          "source_row": 82,
          "text": "\u0a28\u0a48\u0a36\u0a28\u0a32 \u0a39\u0a30\u0a40\u0a15\u0a47\u0a28 \u0a38\u0a48\u0a02\u0a1f\u0a30 (\u0a10\u0a28.\u0a10\u0a1a.\u0a38\u0a40.) \u0a26\u0a3e \u0a15\u0a39\u0a3f\u0a23\u0a3e \u0a39\u0a48 \u0a15\u0a3f \u0a07\u0a38 \u0a38\u0a2e\u0a47\u0a02 \u0a1c\u0a48\u0a30\u0a40 \u0a24\u0a4b\u0a02 \u0a38\u0a3e\u0a28\u0a42\u0a70 \u0a07\u0a38 \u0a16\u0a47\u0a24\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a4b\u0a08 \u0a16\u0a24\u0a30\u0a3e \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48\u0964"
        },
        {
          "id": "pa-0977",
          "lang": "pa",
          "tier": "long",
          "source_row": 977,
          "text": "\u0a2e\u0a41\u0a71\u0a16 \u0a05\u0a71\u0a16\u0a30 \u0a38\u0a40 \u0a05\u0a24\u0a47 \u0a1c\u0a40 \u0a26\u0a47\u0a16\u0a23 \u0a32\u0a08 \u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a28, \u0a15\u0a3f\u0a09\u0a02\u0a15\u0a3f \u0a07\u0a39\u0a28\u0a3e\u0a02 \u0a26\u0a3e \u0a09\u0a1a\u0a3e\u0a30\u0a28 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a47 \u0a38\u0a35\u0a30-\u0a05\u0a71\u0a16\u0a30\u0a3e\u0a02 \u0a26\u0a47 \u0a06\u0a27\u0a3e\u0a30 '\u0a24\u0a47 \u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a48\u0964"
        },
        {
          "id": "or-0007",
          "lang": "or",
          "tier": "short",
          "source_row": 7,
          "text": "\u0b38\u0b47 \u0b71\u0b3e\u0b07\u0b2b\u0b3e\u0b07 \u0b21\u0b4b\u0b30\u0b4d \u0b2c\u0b47\u0b32\u0b4d \u0b28\u0b3f\u0b30\u0b4d\u0b2e\u0b3e\u0b23 \u0b15\u0b30\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b15\u0b39\u0b3f\u0b1b\u0b28\u0b4d\u0b24\u0b3f\u0964"
        },
        {
          "id": "or-0320",
          "lang": "or",
          "tier": "short",
          "source_row": 320,
          "text": "\u0b38\u0b3e\u0b25\u0b40 \u0b15\u0b41\u0b38\u0b4d\u0b24\u0b3f\u0b2f\u0b4b\u0b26\u0b4d\u0b27\u0b3e\u0b2e\u0b3e\u0b28\u0b47 \u0b2e\u0b27\u0b4d\u0b5f \u0b32\u0b41\u0b28\u0b3e\u0b19\u0b4d\u0b15\u0b41 \u0b36\u0b4d\u0b30\u0b26\u0b4d\u0b27\u0b3e\u0b1e\u0b4d\u0b1c\u0b33\u0b3f \u0b05\u0b30\u0b4d\u0b2a\u0b23 \u0b15\u0b30\u0b3f\u0b25\u0b3f\u0b32\u0b47\u0964"
        },
        {
          "id": "or-0942",
          "lang": "or",
          "tier": "medium",
          "source_row": 942,
          "text": "\u0b30\u0b15\u0b4d\u0b37\u0b23\u0b36\u0b40\u0b33 \u0b16\u0b4d\u0b30\u0b40\u0b37\u0b4d\u0b1f\u0b3f\u0b06\u0b28 \u0b27\u0b30\u0b4d\u0b2e, \u0b2e\u0b4b\u0b32\u0b21\u0b4b\u0b2d\u0b3e\u0b30 \u0b2e\u0b41\u0b16\u0b4d\u0b5f \u0b27\u0b30\u0b4d\u0b2e \u0b05\u0b1f\u0b47\u0964"
        },
        {
          "id": "or-0030",
          "lang": "or",
          "tier": "medium",
          "source_row": 30,
          "text": "\u0b0f\u0b39\u0b3f \u0b06\u0b2c\u0b3f\u0b37\u0b4d\u0b15\u0b3e\u0b30 \u0b2a\u0b15\u0b4d\u0b37\u0b40\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b36\u0b30\u0b40\u0b30\u0b30\u0b47 \u0b2a\u0b30\u0b30 \u0b15\u0b4d\u0b30\u0b2e\u0b2c\u0b3f\u0b15\u0b3e\u0b36 \u0b2c\u0b3f\u0b37\u0b5f\u0b30\u0b47 \u0b2e\u0b27\u0b4d\u0b5f \u0b05\u0b28\u0b4d\u0b24\u0b30\u0b4d\u0b26\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b47\u0964"
        },
        {
          "id": "or-0082",
          "lang": "or",
          "tier": "long",
          "source_row": 82,
          "text": "\u0b1c\u0b3e\u0b24\u0b40\u0b5f \u0b18\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23\u0b3f\u0b2c\u0b33\u0b5f \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 (NHC) \u0b15\u0b39\u0b3f\u0b1b\u0b3f \u0b2f\u0b47, \u0b0f\u0b39\u0b3f \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b1c\u0b47\u0b30\u0b40 \u0b05\u0b2c\u0b24\u0b30\u0b23 \u0b15\u0b32\u0b47 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2c\u0b3f\u0b2a\u0b26 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964"
        },
        {
          "id": "or-0977",
          "lang": "or",
          "tier": "long",
          "source_row": 977,
          "text": "\u0b27\u0b4d\u0b5f\u0b3e\u0b28 \u0b26\u0b47\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2e\u0b41\u0b16\u0b4d\u0b5f \u0b05\u0b15\u0b4d\u0b37\u0b30\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b39\u0b47\u0b09\u0b1b\u0b3f c \u0b0f\u0b2c\u0b02 g, \u0b2f\u0b47\u0b39\u0b47\u0b24\u0b41 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b30 \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 \u0b28\u0b3f\u0b2e\u0b4d\u0b28 \u0b38\u0b4d\u0b35\u0b30 \u0b09\u0b2a\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b39\u0b4b\u0b07\u0b25\u0b3e\u0b0f\u0964"
        },
        {
          "id": "ur-0007",
          "lang": "ur",
          "tier": "short",
          "source_row": 7,
          "text": "\u0627\u0633 \u0646\u06d2 \u06a9\u06c1\u0627 \u06a9\u06c1 \u0627\u0633 \u0646\u06d2 \u0627\u06cc\u06a9 \u0648\u0627\u0626\u06cc \u0641\u0627\u0626\u06cc \u0688\u0648\u0631 \u0628\u06cc\u0644 \u0627\u062e\u062a\u0631\u0627\u0639 \u06a9\u06cc\u0627 \u06c1\u06d2\u06d4"
        },
        {
          "id": "ur-0320",
          "lang": "ur",
          "tier": "short",
          "source_row": 320,
          "text": "\u0633\u0627\u062a\u06be\u06cc \u067e\u06c1\u0644\u0648\u0627\u0646\u0648\u06ba \u0646\u06d2 \u0628\u06be\u06cc \u0644\u0648\u0646\u0627 \u06a9\u0648 \u062e\u0631\u0627\u062c\u0650 \u0639\u0642\u06cc\u062f\u062a \u067e\u06cc\u0634 \u06a9\u06cc\u0627\u06d4"
        },
        {
          "id": "ur-0942",
          "lang": "ur",
          "tier": "medium",
          "source_row": 942,
          "text": "\u0645\u0648\u0644\u0688\u0648\u0627 \u06a9\u0627 \u0633\u0628 \u0633\u06d2 \u0628\u0691\u0627 \u0645\u0630\u06c1\u0628 \u06a9\u0679\u0631 \u0639\u06cc\u0633\u0627\u0626\u06cc\u062a \u06c1\u06d2\u06d4"
        },
        {
          "id": "ur-0030",
          "lang": "ur",
          "tier": "medium",
          "source_row": 30,
          "text": "\u06cc\u06c1 \u062a\u062d\u0642\u06cc\u0642 \u067e\u0631\u0646\u062f\u0648\u06ba \u0645\u06cc\u06ba \u067e\u0631\u0648\u06ba \u06a9\u06d2 \u0627\u0631\u062a\u0642\u0627\u0621 \u06a9\u0627 \u0627\u062f\u0631\u0627\u06a9 \u0628\u06be\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u06cc \u06c1\u06d2\u06d4"
        },
        {
          "id": "ur-0082",
          "lang": "ur",
          "tier": "long",
          "source_row": 82,
          "text": "\u0646\u06cc\u0634\u0646\u0644 \u06c1\u0631\u06cc\u06a9\u06cc\u0646 \u0633\u06cc\u0646\u0679\u0631 (\u0627\u06cc\u0646 \u0627\u06cc\u0686 \u0633\u06cc) \u06a9\u06c1\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0633 \u0645\u0648\u0642\u0639 \u067e\u0631 \u062c\u06cc\u0631\u06cc\u060c \u0632\u0645\u06cc\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0633\u06cc \u062e\u0637\u0631\u06d2 \u06a9\u0627 \u0628\u0627\u0639\u062b \u0646\u06c1\u06cc\u06ba\u06d4"
        },
        {
          "id": "ur-0977",
          "lang": "ur",
          "tier": "long",
          "source_row": 977,
          "text": "\u0648\u06c1 \u062e\u0627\u0635 \u062d\u0631\u0648\u0641 \u062c\u0646 \u067e\u0631 \u062f\u06be\u06cc\u0627\u0646 \u0631\u06a9\u06be\u0646\u0627 \u0686\u0627\u06c1\u0626\u06d2 \u0648\u06c1 \u0633\u06cc \u0627\u0648\u0631 \u062c\u06cc \u06c1\u06cc\u06ba \u062d\u0627\u0644\u0627\u0646\u06a9\u06c1 \u0627\u0646 \u06a9\u0627 \u062a\u0644\u0651\u0641\u0638 \u0645\u0646\u062f\u0631\u062c\u06c1 \u0630\u06cc\u0644 \u062d\u0631\u0648\u0641 \u0639\u0644\u062a \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u062a\u0628\u062f\u06cc\u0644 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4"
        }
      ]
    }
  },
