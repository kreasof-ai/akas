+                input_dtype=x.dtype,
+                round_inputs=provider == "cuda",
+                routed_input=routed,
+                weight_parts=weight.parts,
+            ),
+            source,
+            *weight.buffers,
+            *routing,
+            out,
+        )
+        return out
+
+    gate = projection("gate", x, False)
+    up = projection("up", x, False)
+    activation = graph.buffer(prefix + "activation", (rows, top, hidden), "float32")
