+
+    def projection(part, source, routed):
+        weight = weights[part]
+        out = graph.buffer(prefix + part, (rows, top, weight.shape[1]), "float32")
+        routing = (ids, counts) if rows == 1 else (counts, routes)
+        graph(
+            "quantized_experts",
+            dict(
+                r=rows,
+                top=top,
+                experts=experts,
