+
+    class Timed(Session):
+        def prefill(self, prompts, *, read):
+            now[0] += 4
+
+        def decode(self, n, *, read):
+            now[0] += 2
+
+    captures = []
+
+    def capture(session):
+        captures.append(session)
+        now[0] += 100
+
+    session = Timed()
+    result = run(session, Case(4, 5, generated=2), repeats=2, warmup=1,
+                 clock=lambda: now[0], after_prefill=capture)
+    assert captures == [session]
