@@ -5,6 +5,139 @@ from akas.kernels.definition import KernelSpec
 from akas.kernels.kernel import Tensor, kernel, output
 
 
+def window_attention(spec, schedule):
+    """Split circular GQA with one query per workgroup and shared F16 KV tiles."""
+    import tilelang.language as T
+    from tensor.compiler.webgpu.schedules.registers import registers, vector
+
+    p = {**spec.parameters, **schedule}
+    rows, heads, kh, d, cap, chunk, window, splits = (
+        p[n] for n in ("r", "h", "kh", "d", "capacity", "chunk", "window", "splits")
+    )
+    group = heads // kh
+    if d not in (64, 128) or heads % kh or group not in (1, 2, 4, 8):
+        raise ValueError("unsupported circular WebGPU attention geometry")
+    if p.get("query_rows", 1) != 1 or p.get("key_rows", 32) != 32:
+        raise ValueError("circular WebGPU attention uses one query and 32-key tiles")
+    shape = (rows // chunk, kh, cap, d)
+
+    @T.macro
+    def exchange(value, offset):
+        return T.call_extern("float32", "subgroupShuffleXor", value, T.uint32(offset))
+
+    def dot_terms(queries, keys, head, channel, lane):
+        left = vector([queries[head, channel * 4 + j] for j in range(4)])
+        right = vector([T.cast(keys[channel * 4 + j, lane], "float32") for j in range(4)])
+        return T.call_extern("float32", "dot", left, right)
+
+    @kernel
+    def compute(
+        q: Tensor((rows, heads * d), "float32"),
+        kc: Tensor(shape, "float16"),
+        vc: Tensor(shape, "float16"),
+        positions: Tensor((rows,), "int32"),
+        enabled: Tensor((rows,), "int32"),
+    ) -> Tensor((rows * heads * splits * (d + 2),), "float32"):
+        out = output((rows * heads * splits * (d + 2),), "float32")
+        with T.Kernel(kh, rows, splits, threads=group * 32) as (kv_head, row, part):
+            tx = T.get_thread_binding()
+            head, lane = tx // 32, tx % 32
+            first = T.max(0, positions[row] - window + 1) if window else 0
+            last = T.if_then_else(enabled[row] != 0, positions[row] + 1, first)
+            tiles = T.ceildiv(T.max(last - first, 0), 32)
+            span = T.ceildiv(tiles, splits)
+            begin, end = first + part * span * 32, T.min(last, first + (part + 1) * span * 32)
+            queries = T.alloc_shared((group, d), "float32")
+            keys = T.alloc_shared((d, 33), "float16")
+            values = T.alloc_shared((32, d), "float16")
+            probabilities = T.alloc_shared((group, 32), "float32")
+            a0, a1 = T.alloc_var("float32"), T.alloc_var("float32")
+            a2, a3 = T.alloc_var("float32"), T.alloc_var("float32")
+            a0, a1, a2, a3 = 0, 0, 0, 0
+            maximum, normalizer = T.alloc_var("float32"), T.alloc_var("float32")
+            maximum, normalizer = -1e30, 0
+            for i in T.unroll(d // 32):
+                queries[head, lane + i * 32] = q[row, (kv_head * group + head) * d + lane + i * 32]
+            T.sync_threads()
+            for tile in T.serial(T.ceildiv(T.max(end - begin, 0), 32)):
+                base = begin + tile * 32
+                for key, channel in T.Parallel(32, d):
+                    keys[channel, key] = T.if_then_else(base + key < end,
+                        kc[row // chunk, kv_head, (base + key) % cap, channel], 0)
+                    values[key, channel] = T.if_then_else(base + key < end,
+                        vc[row // chunk, kv_head, (base + key) % cap, channel], 0)
+                T.sync_threads()
+                score = T.alloc_var("float32")
+                score = 0
+                for channel in T.serial(d // 4):
+                    score += dot_terms(queries, keys, head, channel, lane)
+                score = T.if_then_else(base + lane < end, score * d**-0.5, -1e30)
+                peak = T.alloc_var("float32")
+                peak = score
+                for step in T.unroll(5):
+                    peak = T.max(peak, exchange(peak, 16 >> step))
+                next_max = T.max(maximum, peak)
+                correction = T.exp(maximum - next_max)
+                probability = T.if_then_else(base + lane < end, T.exp(score - next_max), 0)
+                total = T.alloc_var("float32")
+                total = probability
+                for step in T.unroll(5):
+                    total += exchange(total, 16 >> step)
+                normalizer = normalizer * correction + total
+                maximum = next_max
+                probabilities[head, lane] = probability
+                a0, a1, a2, a3 = a0 * correction, a1 * correction, a2 * correction, a3 * correction
+                T.sync_threads()
+                for key in T.serial(32):
+                    a0 += probabilities[head, key] * T.cast(values[key, lane], "float32")
+                    a1 += probabilities[head, key] * T.cast(values[key, lane + 32], "float32")
+                    if d == 128:
+                        a2 += probabilities[head, key] * T.cast(values[key, lane + 64], "float32")
+                        a3 += probabilities[head, key] * T.cast(values[key, lane + 96], "float32")
+                T.sync_threads()
+            offset = ((row * heads + kv_head * group + head) * splits + part) * (d + 2)
+            out[offset + lane], out[offset + lane + 32] = a0, a1
+            if d == 128:
+                out[offset + lane + 64], out[offset + lane + 96] = a2, a3
+            if lane == 0:
+                out[offset + d] = maximum
+                out[offset + d + 1] = normalizer
+        return out
+
+    return compute.with_attr("tirx.noalias", True)
+
+
+def window_merge(spec, schedule):
+    """Merge split softmax statistics without fragment reductions."""
+    import tilelang.language as T
+
+    p = {**spec.parameters, **schedule}
+    rows, heads, d, splits = (p[n] for n in ("r", "h", "d", "splits"))
+
+    @kernel
+    def compute(
+        parts: Tensor((rows * heads * splits * (d + 2),), "float32"),
+        enabled: Tensor((rows,), "int32"),
+    ) -> Tensor((rows * heads * d,), "float32"):
+        out = output((rows * heads * d,), "float32", position=1)
+        with T.Kernel(heads * rows, threads=d) as index:
+            tx = T.get_thread_binding()
+            maximum, total, result = T.alloc_var("float32"), T.alloc_var("float32"), T.alloc_var("float32")
+            maximum, total, result = -1e30, 0, 0
+            for part in T.serial(splits):
+                maximum = T.max(maximum, parts[(index * splits + part) * (d + 2) + d])
+            for part in T.serial(splits):
+                base = (index * splits + part) * (d + 2)
+                factor = T.exp(parts[base + d] - maximum)
+                total += parts[base + d + 1] * factor
+                result += parts[base + tx] * factor
+            out[index * d + tx] = T.if_then_else(enabled[index // heads] != 0,
+                result / T.max(total, 1e-30), 0)
+        return out
+
+    return compute
+
