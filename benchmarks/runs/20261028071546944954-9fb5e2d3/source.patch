+                for i, group, lane in T.Parallel(bm, bn // 32, 32):
+                    scale = T.max(maximum[i, group] / T.float32(127), T.float32(1e-20))
+                    quantized[i, group * 32 + lane] = T.cast(
+                        T.round(activated[i, group, lane] / scale), "int8"
