+            q = T.meta_var(T.view(x, (r, k), dtype="int8"))
+            a = T.alloc_shared((bm, bk + 16), "int8")
+            b = T.alloc_shared((bn, bk + 16), "int8")
+            sa = T.alloc_shared((bm, groups), "float32")
+            sb = T.alloc_shared((bn, groups), "float32")
