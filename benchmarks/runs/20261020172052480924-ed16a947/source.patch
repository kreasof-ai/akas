+                scales = np.repeat(values[metadata][slot, :, start:stop], 128, axis=-1)[
+                    ..., :depth
+                ]
+                expected[target][slot, :, start:stop] = (block * scales).astype(
+                    "float16"
+                )
+    return ValidationCase(values, expected, rtol=0, atol=0)
