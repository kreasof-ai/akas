+    value = BufferSpec((32,), "uint8")
+    scale = BufferSpec((1,), "float32")
+    with pytest.raises(ValueError, match="uniquely name every metadata buffer"):
+        Storage(value, (scale,))
+    with pytest.raises(ValueError, match="uniquely name every metadata buffer"):
