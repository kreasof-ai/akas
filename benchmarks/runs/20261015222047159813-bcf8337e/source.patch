+def grouped(spec: KernelSpec, schedule: Mapping[str, object]):
+    from akas.ops.attention.cuda import grouped_flat as grouped_kernel
+
+    p = {**spec.parameters, **schedule}
+    return grouped_kernel(p, p.get("stage", 32), p.get("warps", 2))
