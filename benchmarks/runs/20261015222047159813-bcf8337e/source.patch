+def schedule(rows, k, o, width):
+    m = 64 if rows >= 128 else 32 if rows >= 32 and o > width else 16
+    return dict(
+        r=rows, k=k, o=o, m=m, n=64, bk=128, parts=8 if o == width and k > width else 1
+    )
+
