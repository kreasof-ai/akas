+    if profile in ('searched', 'decode_searched') and kind in ('linear', 'ffn') and (p.get('r') == 32) and (p.get('type') == 1):
+        shape = (p['k'], p['o'])
+        if shape in ((1024, 2560), (2560, 1024)):
