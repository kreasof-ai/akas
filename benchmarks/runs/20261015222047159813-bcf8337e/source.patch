+                for j in T.Parallel(d):
+                    offset = T.if_then_else(
+                        head < heads, head * 2 * d, 2 * heads * d + (head - heads) * d
+                    )
+                    value = T.cast(T.cast(proj[row, offset + j], "bfloat16"), "float32")
+                    weight = T.if_then_else(head < heads, qw[j], kw[j])
+                    normal[j] = (
