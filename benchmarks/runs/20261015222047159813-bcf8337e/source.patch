new file mode 100644
index 0000000..f9912e0
--- /dev/null
+++ b/tools/baselines/llama.py
@@ -0,0 +1,145 @@
+"""llama.cpp localhost-server preflight using the common worker protocol."""
+
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import time
+import urllib.request
+from tools.baselines.common import main, measurements, synthetic_prompts
+
+
+def run(config):
+    capacity = max(b for b, _ in config["shapes"])
+    context = max(p for _, p in config["shapes"]) + config["output_tokens"]
+    command = [
+        config["binary"],
+        "-m",
+        config["checkpoint"],
+        "-ngl",
+        "99",
+        "--device",
+        "CUDA0" if config["provider"] == "cuda" else "Vulkan0",
+        "-c",
+        str(context * capacity),
+        "-np",
+        str(capacity),
+        "-b",
+        "2048",
+        "-ub",
+        "512",
+        "-t",
+        "2",
+        "-fa",
+        "on",
+        # The workload starts from empty prefixes. Retained prompt copies and
+        # recurrent-state checkpoints otherwise consume host RAM across bursts.
+        "--cache-ram",
+        "0",
+        "--ctx-checkpoints",
+        "0",
+        "--no-cache-idle-slots",
+        "--host",
+        "127.0.0.1",
+        "--port",
+        "8817",
+        "--no-webui",
+    ]
+    report = dict(
+        runtime="llama.cpp",
+        command=command,
+        revision=config["runtime_revision"],
+        cases=[],
+    )
+    listing = subprocess.check_output(
+        [config["binary"], "--list-devices"],
+        stderr=subprocess.STDOUT,
+        text=True,
+        timeout=30,
+    )
+    selected = "CUDA0:" if config["provider"] == "cuda" else "Vulkan0:"
+    if not any(
+        selected in line and config["device_name"] in line
+        for line in listing.splitlines()
+    ):
+        raise RuntimeError(
+            "requested NVIDIA GPU is absent from the baseline device list: " + listing
+        )
+    report["device_listing"] = listing
+    process = None
+
+    def request(path, data=None):
+        req = urllib.request.Request(
+            "http://127.0.0.1:8817" + path,
+            data=None if data is None else json.dumps(data).encode(),
+            headers={"Content-Type": "application/json"},
+        )
+        with urllib.request.urlopen(req, timeout=600) as response:
+            return json.load(response)
+
+    try:
+        process = subprocess.Popen(
+            command, stdout=None, stderr=None, start_new_session=False
+        )
+        until = time.monotonic() + 120
+        while True:
+            if process.poll() is not None:
+                raise RuntimeError(f"llama-server exited: {process.returncode}")
+            try:
+                if request("/health").get("status") == "ok":
+                    break
+            except Exception:
+                if time.monotonic() > until:
+                    raise TimeoutError("server startup exceeded 120s")
+                time.sleep(0.25)
+        from concurrent.futures import ThreadPoolExecutor
+
+        def invoke(batch, prefix):
+            prompts = synthetic_prompts(config["vocab"], batch, prefix)
+            payload = dict(
+                prompt=None,
+                n_predict=config["output_tokens"],
+                temperature=0,
+                seed=17,
+                ignore_eos=True,
+                cache_prompt=False,
+                return_tokens=True,
+            )
+            with ThreadPoolExecutor(max_workers=batch) as executor:
+                outputs = list(
+                    executor.map(
+                        lambda ids: request("/completion", {**payload, "prompt": ids}),
+                        prompts,
+                    )
+                )
+            if any(o["tokens_predicted"] != config["output_tokens"] for o in outputs):
+                raise ValueError("llama.cpp returned the wrong output count")
+            timings = [o["timings"] for o in outputs]
+            # llama.cpp exposes server eval phases, not client TTFT. Keep that
+            # protocol distinct from request timestamp metrics in other runtimes.
+            return [o["tokens"] for o in outputs], dict(
+                responses=outputs,
+                phase_protocol="llama-server-eval-v1",
+                prefill_tokens_per_second=batch
+                * prefix
+                / max(t["prompt_ms"] / 1000 for t in timings),
+                decode_tokens_per_second=batch
+                * (config["output_tokens"] - 1)
+                / max(t["predicted_ms"] / 1000 for t in timings),
+            )
+
+        measurements(config, invoke, report)
+    finally:
+        if process is not None and process.poll() is None:
+            process.terminate()
+            try:
+                process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait()
+    return report
+
+
+if __name__ == "__main__":
+    main(run)
diff --git a/tools/baselines/sglang.py b/tools/baselines/sglang.py
new file mode 100644
index 0000000..446018f
--- /dev/null
+++ b/tools/baselines/sglang.py
@@ -0,0 +1,83 @@
+"""SGLang eager preflight using the common worker protocol."""
+
+from tools.baselines.common import main, synthetic_prompts, measurements, phase_metrics
+
+
+def run(config):
+    import time
+    import torch
+    import sglang
+    from transformers import AutoTokenizer
+
+    settings = dict(
+        model_path=config["checkpoint"],
+        dtype="bfloat16",
+        context_length=max(p for _, p in config["shapes"])
+        + config["output_tokens"]
+        + 8,
+        max_running_requests=max(b for b, _ in config["shapes"]),
+        chunked_prefill_size=2048,
+        mem_fraction_static=0.85 if config.get("optimized") else 0.45,
+        disable_cuda_graph=not config.get("optimized", False),
+        enable_metrics=True,
+        disable_radix_cache=True,
+        random_seed=17,
+        log_level="info",
+        **config["runtime_options"],
+    )
+    if config.get("optimized"):
+        settings["cuda_graph_bs_decode"] = sorted({b for b, _ in config["shapes"]})
+    if config["mode"] == "mtp":
+        settings.update(
+            speculative_algorithm="EAGLE",
+            speculative_num_steps=1,
+            speculative_eagle_topk=1,
+            speculative_num_draft_tokens=2,
+        )
+    sampling = dict(
+        temperature=0, max_new_tokens=config["output_tokens"], ignore_eos=True
+    )
+    report = dict(
+        runtime="sglang",
+        version=sglang.__version__,
+        settings=settings,
+        sampling=sampling,
+        cases=[],
+    )
+    engine = sglang.Engine(**settings)
+    try:
+        tokenizer = AutoTokenizer.from_pretrained(config["checkpoint"])
+
+        def invoke(batch, prefix):
+            outputs = engine.generate(
+                input_ids=synthetic_prompts(config["vocab"], batch, prefix),
+                sampling_params=sampling,
+            )
+            torch.cuda.synchronize()
+            if isinstance(outputs, dict):
+                outputs = [outputs]
+            meta = [row["meta_info"] for row in outputs]
+            if any(m["cached_tokens"] != 0 for m in meta):
+                raise ValueError("prefix reuse violates the empty-cache workload")
+            phases = phase_metrics(
+                batch,
+                prefix,
+                config["output_tokens"],
+                [m["prefill_finished_time"] - m["request_received_ts"] for m in meta],
+                [m["request_finished_ts"] - m["prefill_finished_time"] for m in meta],
+            )
+            phases["phase_protocol"] = "sglang-scheduler-phase-v1"
+            phases.pop("ttft_seconds")
+            phases.pop("tpot_seconds")
+            return [row["output_ids"] for row in outputs], dict(
+                responses=outputs, **phases
+            )
+
+        measurements(config, invoke, report)
+    finally:
+        engine.shutdown()
+    return report
+
+
+if __name__ == "__main__":
+    main(run)
diff --git a/tools/baselines/vllm.py b/tools/baselines/vllm.py
new file mode 100644
index 0000000..4256e4b
--- /dev/null
+++ b/tools/baselines/vllm.py
@@ -0,0 +1,71 @@
+"""vLLM eager preflight: the same input/output protocol as other baseline workers."""
+
+from tools.baselines.common import main, synthetic_prompts, measurements, phase_metrics
+
+
+def run(config):
+    import dataclasses
+    import time
+    import torch
+    import vllm
+    from vllm import LLM, SamplingParams
+    from vllm._version import __commit_id__
+
+    settings = dict(
+        model=config["checkpoint"],
+        dtype="bfloat16",
+        max_model_len=max(p for _, p in config["shapes"]) + config["output_tokens"],
+        max_num_seqs=max(b for b, _ in config["shapes"]),
+        max_num_batched_tokens=2048,
+        gpu_memory_utilization=0.85 if config.get("optimized") else 0.45,
+        enforce_eager=not config.get("optimized", False),
+        enable_prefix_caching=False,
+        disable_log_stats=False,
+        seed=17,
+        **config["runtime_options"],
+    )
+    if config.get("optimized"):
+        settings["compilation_config"] = dict(
+            cudagraph_capture_sizes=sorted({b for b, _ in config["shapes"]})
+        )
+    if config["mode"] == "mtp":
+        settings["speculative_config"] = dict(method="mtp", num_speculative_tokens=1)
+    report = dict(
+        runtime="vllm",
+        version=vllm.__version__,
+        revision=__commit_id__,
+        settings=settings,
+        cases=[],
+    )
+    llm = LLM(**settings)
+    tokenizer = llm.get_tokenizer()
+    params = SamplingParams(
+        temperature=0, max_tokens=config["output_tokens"], ignore_eos=True
+    )
+
+    def invoke(batch, prefix):
+        prompts = [
+            dict(prompt_token_ids=ids)
+            for ids in synthetic_prompts(config["vocab"], batch, prefix)
+        ]
+        outputs = llm.generate(prompts, params, use_tqdm=False)
+        torch.cuda.synchronize()
+        tokens = [list(row.outputs[0].token_ids) for row in outputs]
+        metrics = [dataclasses.asdict(row.metrics) for row in outputs]
+        if any(row.get("is_corrupted") for row in metrics):
+            raise ValueError("vLLM flagged corrupted outputs")
+        phases = phase_metrics(
+            batch,
+            prefix,
+            config["output_tokens"],
+            [m["first_token_latency"] for m in metrics],
+            [m["last_token_ts"] - m["first_token_ts"] for m in metrics],
+        )
+        return tokens, dict(request_metrics=metrics, **phases)
+
+    measurements(config, invoke, report)
+    return report
+
+
+if __name__ == "__main__":
+    main(run)
diff --git a/tools/campaign.py b/tools/campaign.py
new file mode 100644
index 0000000..8c99ce6
--- /dev/null
+++ b/tools/campaign.py
@@ -0,0 +1,236 @@
+"""Run a declared model matrix serially, with cumulative campaign and per-model budgets."""
+
+import argparse
+from dataclasses import asdict
+import json
+from pathlib import Path
+import time
+
+from akas.benchmarking.history import source_identity, utc, write
+from akas.optimization.context import Context, discover, duration, identity, workload
+from akas.optimization.supervisor import lock, optimize
+
+
+def declarations(spec, root):
+    return {
+        name: json.loads((root / "benchmarks/models" / (name + ".json")).read_text())
+        for name in spec["models"]
+    }
+
+
+def entries(spec, root):
+    result = []
+    for name, model in declarations(spec, root).items():
+        for precision in spec["formats"]:
+            path = (root / model["weights"][precision]["path"]).resolve()
+            try:
+                definition, error = discover(path), None
+            except (ValueError, OSError) as failure:
+                definition, error = None, f"{type(failure).__name__}: {failure}"
+            for backend in spec["backends"]:
+                for cache in spec["caches"]:
+                    for mode in model["modes"]:
+                        key = "-".join((name, precision, backend, cache, mode))
+                        if error:
+                            result.append(
+                                dict(
+                                    id=key,
+                                    status="failed",
+                                    error=error,
+                                    checkpoint=str(path),
+                                )
+                            )
+                            continue
+                        context = Context(
+                            str(path),
+                            definition,
+                            workload(spec["workload"]),
+                            backend=backend,
+                            kv_dtype=None if cache == "default" else cache,
+                            mode=mode,
+                        )
+                        result.append(dict(id=key, context=asdict(context)))
+    return result
+
+
+def run(specification, out, *, budget, slice_seconds, history):
+    started = time.monotonic()
+    root = Path(__file__).resolve().parents[1]
+    spec = json.loads(Path(specification).read_text())
+    models = declarations(spec, root)
+    frozen = dict(
+        spec=spec,
+        models=models,
+        workload=workload(spec["workload"]),
+        source=source_identity(root)["tree_sha256"],
+    )
+    fingerprint = identity(frozen)
+    cap = duration(spec.get("configuration_budget", "1h"))
+    out = Path(out).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    with lock(out / ".lock"):
+        path = out / "campaign.json"
+        if path.exists():
+            state = json.loads(path.read_text())
+            if state["identity"] != fingerprint or state["budget_seconds"] != budget:
+                raise ValueError(
+                    "campaign source, specification, model declarations or total budget changed; use a new output directory"
+                )
+        else:
+            state = dict(
+                schema="akas.matrix-campaign.v1",
+                identity=fingerprint,
+                specification=spec,
+                models=models,
+                source=source_identity(root),
+                created_at=utc(),
+                budget_seconds=budget,
+                configuration_budget_seconds=cap,
+                spent_seconds=0,
+                entries=entries(spec, root),
+            )
+        # A hard-killed coordinator cannot know how much of its last grant was
+        # used. Charge the reserved grant rather than silently reset that time.
+        active = state.pop("active", None)
+        if active:
+            state["spent_seconds"] = max(
+                state["spent_seconds"], active["spent_before"] + active["allowance"]
+            )
+            entry = next(e for e in state["entries"] if e["id"] == active["id"])
+            entry["spent_seconds"] = entry.get("spent_seconds", 0) + active["allowance"]
+            entry["recovered_interruption"] = utc()
+        previous_spent = state["spent_seconds"]
+
+        def save():
+            state.update(
+                spent_seconds=previous_spent + time.monotonic() - started,
+                updated_at=utc(),
+            )
+            write(path, state)
+
+        state["status"] = "running"
+        save()
+        try:
+            while time.monotonic() - started + previous_spent < budget:
+                if (
+                    source_identity(root)["tree_sha256"] != frozen["source"]
+                    or declarations(spec, root) != models
+                    or json.loads(Path(specification).read_text()) != spec
+                    or workload(spec["workload"]) != frozen["workload"]
+                ):
+                    state["status"] = "invalidated"
+                    raise ValueError("campaign inputs changed during execution")
+                unfinished = [
+                    e
+                    for e in state["entries"]
+                    if e.get("status") not in ("complete", "unsupported", "failed")
+                ]
+                pending = [e for e in unfinished if e.get("spent_seconds", 0) < cap]
+                if not pending:
+                    state["status"] = (
+                        "configuration_budgets_exhausted" if unfinished else "complete"
+                    )
+                    break
+                # Give each configuration a first pass before deepening one.
+                entry = min(pending, key=lambda e: e.get("spent_seconds", 0))
+                remaining = budget - (time.monotonic() - started + previous_spent)
+                allowance = min(
+                    slice_seconds, remaining, cap - entry.get("spent_seconds", 0)
+                )
+                print(entry["id"], f"allowance={allowance:.1f}s", flush=True)
+                save()
+                state["active"] = dict(
+                    id=entry["id"],
+                    allowance=allowance,
+                    spent_before=state["spent_seconds"],
+                    started_at=utc(),
+                )
+                write(path, state)
+                tick = time.monotonic()
+                try:
+                    result = optimize(
+                        Context(**entry["context"]),
+                        out / entry["id"],
+                        budget=allowance,
+                        history=history,
+                    )
+                    entry.update(
+                        status=result["status"],
+                        deployment=result.get("deployment"),
+                        winner=result.get("winner"),
+                    )
+                except KeyboardInterrupt:
+                    entry["status"] = "interrupted"
+                    raise
+                except Exception as error:
+                    entry.update(
+                        status="failed", error=f"{type(error).__name__}: {error}"
+                    )
+                finally:
+                    entry["spent_seconds"] = (
+                        entry.get("spent_seconds", 0) + time.monotonic() - tick
+                    )
+                    entry["updated_at"] = utc()
+                    state.pop("active", None)
+                    save()
+            else:
+                state["status"] = "budget_exhausted"
+        except KeyboardInterrupt:
+            state["status"] = "interrupted"
+            raise
+        finally:
+            save()
+        return state
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--spec", type=Path, default=Path("benchmarks/campaigns/standard-v1.json")
+    )
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument(
+        "--budget",
+        required=True,
+        help="cumulative allowance, e.g. 4d; downtime is excluded",
+    )
+    parser.add_argument(
+        "--slice",
+        default="30m",
+        help="maximum grant before moving to the next configuration",
+    )
+    parser.add_argument("--history", type=Path, default=Path("benchmarks"))
+    parser.add_argument(
+        "--list",
+        action="store_true",
+        help="show the requested matrix without running GPU work",
+    )
+    args = parser.parse_args()
+    if args.list:
+        print(
+            json.dumps(entries(json.loads(args.spec.read_text()), Path.cwd()), indent=2)
+        )
+        return
+    state = run(
+        args.spec,
+        args.out,
+        budget=duration(args.budget),
+        slice_seconds=duration(args.slice),
+        history=args.history,
+    )
+    print(
+        json.dumps(
+            dict(
+                status=state["status"],
+                spent_seconds=state["spent_seconds"],
+                configurations=len(state["entries"]),
+            ),
+            indent=2,
+        )
+    )
+    if any(e.get("status") == "failed" for e in state["entries"]):
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
