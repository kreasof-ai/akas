+    )
+
+
+AVAILABLE = "cuda" in dict(FORMAT.providers)
+CAPABILITIES = ("quantize", "dequantize", "read", "read_tile")
+IMPLEMENTATIONS = tuple(choice for choice in _CHOICES if choice.provider == "cuda")
