+def partitioned_flat(spec: KernelSpec, schedule: Mapping[str, object]):
+    from akas.ops.attention.cuda import partial_flat as warp_partial_kernel
+
+    p = {**spec.parameters, **schedule}
+    return warp_partial_kernel(p, p["splits"])
+
