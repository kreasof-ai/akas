+        p["slots"],
+        p["chunk"],
+        p["capacity"],
+        p.get("splits", 16),
+        256,
+    )
+    rows = r * chunk
+    packed = p.get("packed_loads", False)
+    decoded = p.get("decoded_kv", False)
+    tile_rows = p.get("key_rows", 64)
+    query_tokens = p.get("query_tokens", 8)
