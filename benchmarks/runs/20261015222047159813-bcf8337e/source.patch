+def prefill_fp8_experts(spec: KernelSpec, schedule: Mapping[str, object]):
+    from akas.ops.moe.cuda import _bucketed as expert_kernel
+
+    p = {**spec.parameters, **schedule}
+    return expert_kernel({**p, "rows": p["r"]})
